{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "palworld-cheats",
  "compatibility_date": "2026-08-06",
  "main": "worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  }
}
